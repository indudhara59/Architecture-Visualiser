{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Architecture-Visualiser rules",
  "type": "object",
  "properties": {
    "$comment": { "type": "string" },
    "rules": {
      "type": "array",
      "description": "Each rule forbids imports from files matching `from` to files matching `to`.",
      "items": {
        "type": "object",
        "required": ["from", "to"],
        "properties": {
          "name": { "type": "string", "description": "Message shown for violations." },
          "from": { "description": "Glob(s) of importing files, workspace-relative.", "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "to": { "description": "Glob(s) of files that must not be imported.", "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "except": { "description": "Glob(s) exempt from this rule.", "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] },
          "severity": { "enum": ["error", "warning"], "default": "error" }
        }
      }
    },
    "ignore": { "type": "array", "items": { "type": "string" }, "description": "Files never checked." }
  }
}
