{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "rootDir": "."
  },
  "include": ["src", "test"],
  "exclude": ["test/fixtures"]
}
